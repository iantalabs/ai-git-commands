# si-shortcuts — PATH and environment for a Linux VM.
#
# Goes in ~/.profile, which a LOGIN bash reads. That covers both ways you
# actually reach a lab box: the Cloud Shell terminal, and `ssh` into a GCE
# instance (both login shells).
#
# Caveat, the bash equivalent of the zsh one on the mini: `ssh vm 'gs'` is
# NON-login and NON-interactive, so bash reads neither ~/.profile nor ~/.bashrc
# (Debian's ~/.bashrc even returns early when non-interactive). If you need the
# one-shot form, use a login shell explicitly:
#     ssh vm 'bash -lc "gs"'
# That needs no extra file and no BASH_ENV.

case ":$PATH:" in
  *":$HOME/bin:"*) ;;
  *) PATH="$HOME/bin:$PATH" ;;
esac
export PATH

# mf opens ${EDITOR:-code}; there is no VS Code on a lab VM.
command -v vim >/dev/null 2>&1 && export EDITOR="${EDITOR:-vim}" || export EDITOR="${EDITOR:-nano}"

# cmdi installs here rather than /usr/local/bin: no sudo, and it survives being
# run as a non-root lab user.
export CMDI_DEST="$HOME/bin"

# db and dp prefix the image with $DOCKER_USER, default stefian22 (Docker Hub).
# In a GCP lab you almost always want a Google registry instead — uncomment one:
# export DOCKER_USER="gcr.io/${GOOGLE_CLOUD_PROJECT:-$DEVSHELL_PROJECT_ID}"
# export DOCKER_USER="us-central1-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/my-repo"
