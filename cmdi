#!/bin/sh
# command install
# first arg is the cmd file
#
# Installs into $CMDI_DEST, default /usr/local/bin. The mini sets
# CMDI_DEST=$HOME/bin in .zshenv: no sudo needed, and the root LaunchDaemon that
# runs the nightly backup does not inherit these commands on its PATH.
# sudo is used only when the destination is not writable as you.

dest="${CMDI_DEST:-/usr/local/bin}"

if [ -w "$dest" ]; then
  SUDO=""
else
  SUDO="sudo"
fi

echo $SUDO cp "$1" "$dest"

$SUDO cp "$1" "$dest" || exit 1
$SUDO chmod +x "$dest"/"$1"
