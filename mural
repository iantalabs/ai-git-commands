#!/bin/bash
# mural - restart mural's windows on STD: the backdrop on TV2 and the presenter on TV3
#
#   mural             close mural's windows and server, reopen the ones that were open
#                     (none open: backdrop + presenter) as last launched, on fresh code
#   mural help        every command: backdrop, presenter, camera, snap, clip, key, stop, ...
#   mural <cmd> ...   any of them, passed straight to the repo's bin/mural
#
# Self-contained, so `cmdi mural` works: nothing here depends on where this repo lives.
# MURAL_DIR overrides where the mural repo is.

repo="${MURAL_DIR:-$HOME/workspace/iantalabs/mural}"
[ -x "$repo/bin/mural" ] || { echo "mural: no mural repo at $repo (set MURAL_DIR)" >&2; exit 1; }
exec "$repo/bin/mural" "$@"
